diff --git a/quickstep/src/com/android/quickstep/util/RecentsLockUtils.java b/quickstep/src/com/android/quickstep/util/RecentsLockUtils.java
new file mode 100644
index 0000000..776e0d6
--- /dev/null
+++ b/quickstep/src/com/android/quickstep/util/RecentsLockUtils.java
@@ -0,0 +1,54 @@
+package com.android.quickstep.util;
+
+import android.content.Context;
+import android.text.TextUtils;
+
+import com.android.launcher3.LauncherPrefs;
+import com.android.quickstep.views.TaskView;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.Set;
+
+public final class RecentsLockUtils {
+    private static final String SEPARATOR = ",";
+
+    private RecentsLockUtils() {}
+
+    private static Set<String> readLocked(Context context) {
+        String raw = LauncherPrefs.get(context).get(LauncherPrefs.LOCKED_RECENTS_APPS);
+        Set<String> out = new LinkedHashSet<>();
+        if (!TextUtils.isEmpty(raw)) {
+            out.addAll(Arrays.asList(raw.split(SEPARATOR)));
+        }
+        return out;
+    }
+
+    private static String key(int userId, String packageName) {
+        return packageName == null ? "" : userId + "|" + packageName;
+    }
+
+    public static boolean isTaskViewLocked(Context context, TaskView taskView) {
+        Set<String> locked = readLocked(context);
+        if (locked.isEmpty()) return false;
+        for (var container : taskView.getTaskContainers()) {
+            var task = container.getTask();
+            if (locked.contains(key(task.key.userId, task.key.getPackageName()))) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static void setTaskViewLocked(Context context, TaskView taskView, boolean lock) {
+        Set<String> locked = readLocked(context);
+        for (var container : taskView.getTaskContainers()) {
+            var task = container.getTask();
+            String key = key(task.key.userId, task.key.getPackageName());
+            if (key.isEmpty()) continue;
+            if (lock) locked.add(key);
+            else locked.remove(key);
+        }
+        LauncherPrefs.get(context).put(LauncherPrefs.LOCKED_RECENTS_APPS, TextUtils.join(SEPARATOR, locked));
+    }
+}
